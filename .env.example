# 数据库固定使用 SQLite（data/vocabflow.db），无需配置数据库密码。
# 旧部署如设置了指向 PostgreSQL 的 DATABASE_URL，请删除该行，
# 启动时会直接报错提示。

# 每天新卡上限（防堆积）
NEW_CARDS_PER_DAY=10

# 未手动标记时，NGSL 排名前多少的词默认算“已认识”
DEFAULT_KNOWN_RANK=3000

# DeepSeek API Key 只放在服务器 .env 中；不要写入前端、代码或提交到 Git
# DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# 查词、制卡等日常任务关闭思考以保证速度；文章接口可按请求单独开启。
DEEPSEEK_DISABLE_THINKING=true
# AI 短文固定开启思考模式：deepseek-v4-flash 使用 max。
AI_ARTICLE_REASONING_EFFORT=max

# 会话有效期（天）
SESSION_TTL_DAYS=30
APP_TIMEZONE=Asia/Shanghai

# 接受的 Host，正式环境应保留真实域名；逗号分隔
ALLOWED_HOSTS=<个人域名>,localhost,127.0.0.1

# 可信代理 IP（逗号分隔；默认仅信任本机回环）。Docker 网络内互访需信任
# 私网段时显式配置：TRUSTED_PROXY_IPS=loopback,private
# TRUSTED_PROXY_IPS=
# 仅当公网入口是 Cloudflare（Tunnel/回源）时开启：普通反代会转发客户端
# 伪造的 CF-Connecting-IP，开启前请确认入口拓扑
# TRUST_CF_CONNECTING_IP=false

# 正式域名通过 HTTPS 部署时建议 true（强制 Secure Cookie）。
# false 时仍会在实际 HTTPS 请求下自动加 Secure；本地 http 保持 false。
COOKIE_SECURE=false
# 生产保持 false；仅本地改模板调试时开 true
TEMPLATES_AUTO_RELOAD=false

# 旧 Linux 使用 Cloudflare Tunnel 时填写控制台提供的 Tunnel Token。
# 它也是服务器密钥，不要提交或粘贴到聊天中。
# CLOUDFLARE_TUNNEL_TOKEN=

# 真实邮箱注册：正式环境保持 true。Resend 需先验证你的发送域名。
EMAIL_VERIFICATION_REQUIRED=true
# RESEND_API_KEY=re_...
EMAIL_FROM=VocabTool <verify@你的域名>
# 用密码生成器创建一个长随机字符串；不要与 DeepSeek Key 相同
# VERIFICATION_SECRET=
# 用户自带 API Key 默认使用 VERIFICATION_SECRET 派生加密密钥；也可单独配置
# API_KEY_ENCRYPTION_SECRET=another-long-random-secret
VERIFICATION_CODE_TTL_MINUTES=10


# 单文件 10 MB，每位用户总空间 50 MB（单位：字节）
MAX_UPLOAD_BYTES=10485760
MAX_APKG_UPLOAD_BYTES=52428800
USER_STORAGE_QUOTA_BYTES=52428800
# 读取上传请求体的最长等待时间，防止慢上传长期占用连接
UPLOAD_BODY_TIMEOUT_SECONDS=30

# TTS 语音合成配置
# TTS_PROVIDER: edge（默认免费美音 JennyNeural）或 mimo（小米 MiMo-V2.5）
TTS_PROVIDER=edge
# 小米开放平台 API Key（如未配置或失败将自动降级为 Edge-TTS）
# MIMO_API_KEY=sk-...
MIMO_API_BASE=https://api.xiaomimimo.com/v1
MIMO_TTS_MODEL=mimo-v2.5-tts
# 可选预设音色：mimo_default / 冰糖 / 茉莉 / 苏打 / 白桦 / Mia / Chloe 等
# MIMO_TTS_VOICE_EN=mimo_default
# MIMO_TTS_VOICE_ZH=mimo_default

# TTS 音频缓存总容量上限（默认 512 MB），超出后按最旧优先自动清理
TTS_CACHE_MAX_BYTES=536870912

# AI 用量记录保留天数（默认 180，最短 30）
AI_USAGE_RETENTION_DAYS=180
# 平台 Key 的免费额度：每位登录用户每天 50 次 AI 查询、50 张待生成卡片
AI_FREE_DAILY_QUERY_LIMIT=50
AI_FREE_DAILY_CARD_LIMIT=50
# 内部 AI 请求安全上限（格式重试和其它 AI 功能也计数）；0 = 不限制
AI_DAILY_REQUEST_LIMIT=3000  # 高阈值：查 100 词 + 制 2000 张卡也不会触发
# 全站游客每日 AI 查词总量（换 IP 也绕不过）；0 = 不限制
GUEST_AI_DAILY_LIMIT=500
